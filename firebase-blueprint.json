{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Store user specific metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Workout": {
      "title": "Workout Session",
      "description": "A single exercise session for a machine",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "machineId": { "type": "string" },
        "name": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "duration": { "type": "number", "description": "Duration in seconds" },
        "routineName": { "type": "string" },
        "sets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reps": { "type": "number" },
              "weight": { "type": "number" },
              "completed": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["userId", "machineId", "date", "sets"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/users/{userId}/workouts/{workoutId}": {
      "schema": "Workout",
      "description": "User specific workout history"
    }
  }
}
