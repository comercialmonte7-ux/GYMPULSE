rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200;
    }

    function isValidWorkout(data) {
      return data.keys().hasAll(['userId', 'machineId', 'name', 'date', 'sets', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.machineId is string &&
             data.name is string &&
             data.date is string &&
             data.sets is list && data.sets.size() <= 30;
    }

    // 2. Resource Match Blocks
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLogin']));
    }

    match /users/{userId}/workouts/{workoutId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidWorkout(request.resource.data) && isValidId(workoutId);
      allow delete: if isOwner(userId);
      // Updates are not explicitly supported by schema yet but let's allow them with owner check
      allow update: if isOwner(userId) && isValidWorkout(request.resource.data);
    }
  }
}
